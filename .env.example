# Bluewave – die wenigen Angaben, die Docker braucht. Alles andere stellst du in der App ein.
# Als „.env“ neben docker-compose.yml ablegen und die Pfade anpassen. Die .env nie weitergeben.

# Deine Filme und Serien (bleiben nur lesend eingebunden, solange MEDIEN_MOUNT_MODUS nicht rw ist)
FILME_PFAD=/mnt/user/media/filme
SERIEN_PFAD=/mnt/user/media/serien

# Eigene Daten von Bluewave: Datenbank, Poster, Schlüssel, Sicherungen, Transkodier-Zwischendateien (am besten SSD)
APPDATA_PFAD=/mnt/cache/appdata/bluewave

# Port der Web-App: http://<server>:9960
APP_PORT=9960

# Hardware-Beschleunigung: auto (Standard) | quicksync | software   (nvenc, vaapi folgen später)
HWACCEL=auto

# Optional: Benutzer und Gruppe, denen deine Medien gehören (Unraid: 99 und 100). Leer = automatisch erkannt.
PUID=
PGID=
