      VALUE "ProductName", "Bluewave Windows Client"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "InternalName", "Bluewave Windows Client Uninstall"
      VALUE "LegalCopyright", "© Lorenzo Frank · privat"
      VALUE "Comments", "https://github.com/lfrank95/bluewave"
      VALUE "OriginalFilename", "Bluewave deinstallieren.exe"
    END
  END
  BLOCK "VarFileInfo"
